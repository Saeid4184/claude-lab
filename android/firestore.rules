rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // کارشناس ماشین‌آلات — the only role that records/edits data.
    function isExpert() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myRole() == "EXPERT";
    }

    // Expert or manager — anyone approved may read. A freshly-registered (PENDING) account
    // sees nothing until the expert approves it.
    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        myRole() in ["EXPERT", "MANAGER"];
    }

    // users/{uid}:
    //  - an account may create ONLY its own profile, and only as PENDING — except the very
    //    first account, which may create itself as EXPERT in the same batch that claims
    //    meta/owner (existsAfter), and only while meta/owner doesn't exist yet;
    //  - a user may edit their own name but never their own role;
    //  - only the expert may change someone's role or delete an account.
    match /users/{uid} {
      allow read: if isApproved() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSignedIn() && request.auth.uid == uid && (
        request.resource.data.role == "PENDING" ||
        (request.resource.data.role == "EXPERT" &&
          !exists(/databases/$(database)/documents/meta/owner) &&
          existsAfter(/databases/$(database)/documents/meta/owner))
      );
      allow update: if isExpert() ||
        (isSignedIn() && request.auth.uid == uid &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role"]));
      allow delete: if isExpert();
    }

    // meta/owner: claimed exactly once by the first account (see users above); never changed.
    match /meta/owner {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/meta/owner) &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // settings/app: shared config (the Gemini API key). Approved users read, the expert writes.
    match /settings/{docId} {
      allow read: if isApproved();
      allow write: if isExpert();
    }

    // Everything else (vehicles, drivers, fuel, repairs, … added phase by phase): approved users
    // read, only the expert writes.
    match /{collection}/{docId} {
      allow read: if isApproved() && !(collection in ["users", "meta", "settings"]);
      allow write: if isExpert() && !(collection in ["users", "meta", "settings"]);
    }
  }
}
